pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
square_size = 20
padding = 5
offset = 128 -

empty = 5
green = 3
white = 7
orange = 9
yellow = 10

grid = [
	[empty, green, yellow],
	[yellow, white, orange],
	[empty, empty, green],
]


function _update()
end

function _draw()
end
-->8

function shift_right(pos)
	aux = grid[pos.y][0]
	for x=1,2 do
		grid[pos.y][x] = grid[pos.y][x+1]
	end
	grid[pos.y][3] = aux
end
