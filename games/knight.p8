pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
anims = {
	flashing = "flashing",
}

player = {
	x = 5,
	y = 5,
	speed = 1,
	frame = 16,
	dir_x = 1,
	dir_y = 0,
}

goblin_1 = {
	x = 20,
	y = 20,
	frame = 24,
	dir_x = 1,
	dir_y = 0,
	hitbox = {
		x = 0,
		y = 0,
		w = 8,
		h = 8,
	},
	anim = nil,
	anim_frame = 0,
}

knife_meta = {
	hitbox = {
		x = 2,
		y = 3,
		w = 8,
		h = 3,
 }
}
knife = nil

function _init()
	camera()
end

function draw_actor(a)
	local frame = 0
	if a.dir_x > 0 then
		frame = a.frame
	elseif a.dir_x < 0 then
		frame = a.frame+3
	elseif a.dir_y > 0 then
		frame = a.frame+1
	elseif a.dir_y < 0 then
		frame = a.frame+2
	else
		frame = a.last_frame or a.frame
	end
	if a.anim == anims.flashing then
		if a.anim_frame % 8 < 4 then
			frame = 40 --nil
		end
		if (a.anim_frame>16) a.anim=nil
	end
	if a.anim then
		a.anim_frame += 1
	end
	
	spr(frame, a.x, a.y, 1,1,false)
	a.last_frame = frame
end

function _draw()
	local dir_x = 0 dir_y = 0
	if (btn(⬅️)) then dir_x = -1 end
	if (btn(➡️)) then dir_x = 1 end
	if (btn(⬆️)) then dir_y = -1 end
	if (btn(⬇️)) then dir_y = 1 end
	player.dir_x = dir_x
	player.dir_y = dir_y
	player.x += dir_x * player.speed
	player.y += dir_y * player.speed

 local	attack = false
	if (btn(❎)) then attack = true end
	
	cls(1)
	map()
	draw_actor(player)
	draw_actor(goblin_1)
	
	
	if attack then
		knife	= {
			x = player.x,
			y = player.y,
			dir = player.dir_x,
			sprite = 32,
			speed = 2,
			frames = 3,
			curr = 0,
			active = true,
			hitbox = knife_meta.hitbox
		}
		if knife.dir == 0 then
			knife.dir = 1
		end
		knife.curr = 0
	end
	if knife then
		spr(knife.sprite, knife.x, knife.y, 1, 1, knife.dir == -1)	
		local base = {
			x = knife.x + knife_meta.hitbox.x,
			y = knife.y + knife_meta.hitbox.y,
		}
		if is_colliding(knife, goblin_1) and not goblin_1.anim then
			goblin_1.anim = anims.flashing
			goblin_1.anim_frame = 0
			sfx(0)
--   rectfill(
--				base.x,
--				base.y,
--				base.x + knife_meta.hitbox.w-1,
--  		base.y + knife_meta.hitbox.h-1,
--				8
--			)
		end
		if knife.curr < knife.frames then
			knife.x += knife.speed * knife.dir
		else
			knife.x -= knife.speed * knife.dir
		end
		
		knife.curr += 1
		if knife.curr == knife.frames * 2 then
			knife = nil
		end
	end
end
-->8
function actor_to_box(a)
	return {
		x = a.x + a.hitbox.x,
		y = a.y + a.hitbox.y,
		w = a.hitbox.w,
		h = a.hitbox.h,
	}
end

function is_colliding(a1, a2)
	local b1 = actor_to_box(a1)
	local b2 = actor_to_box(a2)
	return (
			(b2.x < b1.x and b1.x < b2.x + b2.w)
			or
			(b1.x < b2.x and b2.x < b1.x + b1.w)
		) and (
			(b2.y < b1.y and b1.y < b2.y + b2.h)
			or
			(b1.y < b2.y and b2.y < b1.y + b1.h)
		)
end
