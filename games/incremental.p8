pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
gravity = 400
dt = 1/30
hspeed = 64

f={
	wall=1,
}

function _init()
	player = {
		pos={x=5, y=128-8},
		v={x=0, y=0},
		size={x=3, y=8}
	}
	treasure = {
		pos={x=100, y=120},
		timer=2,
		action=on_treasure,
	}
	particle = {
		pos={x=100, y=120},
		v={x=0,y=-5},
		sprite=3,
	}
	conveyer = {
		pos={x=64, y=20},
		sprites={17, 18, 19, 20},
		curr_sprite=1,
		anim_timer=0.2,
	}
end

function ground_collision(e)
	e.grounded = false
	if e.size and e.v and e.v.y > 0 then
		local feet = {x=e.pos.x + e.size.x/2, y=e.pos.y+e.size.y-1}
		local at_feet = mget(feet.x/8, feet.y/8)
		if fget(at_feet) & f.wall != 0 then
				e.v.y = 0
				local new_feet = {
					x=feet.x, y=flr((feet.y+1)/8)*8-1
				}
				e.pos.y = new_feet.y-player.size.y+1
				e.grounded = true
		end
	end
end

function _update_ent(e)
	e.pos = vadd(e.pos, vmul(e.v, dt))
	ground_collision(e)
end

function _update()
	cls()
	if btn(➡️) then player.v.x = hspeed
	elseif btn(⬅️) then player.v.x = -hspeed
	else player.v.x = 0 end
	if btn(🅾️) and player.grounded then
		player.v.y = -200
	end
	player.v.y += gravity * dt	
	_update_ent(player)
	_update_ent(particle)
	if dist(player.pos, treasure.pos) < 10 then
		selected = treasure
	else
		selected = nil
	end
	if not conveyer.anim_timer_c then
		conveyer.anim_timer_c = conveyer.anim_timer
	end
	print(".")
		print(".")
			print(".")
	print(conveyer.anim_timer_c)
		print(conveyer.curr_sprite)
	conveyer.anim_timer_c -= dt
	if conveyer.anim_timer_c <= 0 then
		conveyer.anim_timer_c += conveyer.anim_timer
		conveyer.curr_sprite += 1
		if conveyer.curr_sprite > #conveyer.sprites then
			conveyer.curr_sprite = 1
		end
	end
end

function draw_ent(e)
	if e.sprite then
		spr(e.sprite, e.pos.x, e.pos.y)
	elseif e.sprites then
		spr(e.sprites[e.curr_sprite], e.pos.x, e.pos.y)
	elseif e.text then
		print(e.text, e.pos.x, e.pos.y)
	end
end

function draw_hud()
	rectfill(0, 0, 127, 8, 1)
	print("0", 1, 2, 7)
end

function _draw()
	map()
	spr(1, player.pos.x, player.pos.y)
	spr(2, treasure.pos.x, treasure.pos.y)
--	rectfill(feet.x, feet.y, feet.x+7, feet.y+7)
	
	if selected == treasure then
		spr(46, treasure.pos.x - 4, treasure.pos.y - 4, 2, 2)
	end
	draw_ent(particle)
	draw_ent(conveyer)
	
	draw_hud()
	--map()
end
-->8
function dist(p1, p2)
	return sqrt(
		(p1.x-p2.x)*(p1.x-p2.x)+
		(p1.y-p2.y)*(p1.y-p2.y)
	)
end

function vadd(p1, p2)
	return {x=p1.x+p2.x, y=p1.y+p2.y}
end

function vmul(p, s)
	return {x=p.x*s, y=p.y*s}
end
-->8
function on_treasure(e)
	inv.gold += 1
	spawn_particle(e)
end
