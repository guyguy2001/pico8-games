pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
gravity = 400
dt = 1/30
hspeed = 64

f={
	wall=1,
}


function _init()
	log_offset.y = 10
	player = {
		name="player",
		pos={x=5, y=128-8},
		v={x=0, y=0},
		size={x=3, y=8}
	}
	treasure = {
		name="treasure",
		pos={x=100, y=120},
		timer=2,
		action=on_treasure,
	}
	particle = {
		name = "particle",
		pos={x=100, y=120},
		v={x=0,y=-5},
		sprite=3,
	}
	conveyer = {
		name="conveyeur",
		pos={x=64, y=20},
		sprites={17, 18, 19, 20},
		curr_sprite=1,
		anim_timer=0.2,
	}
	collectible = {
		pos = {x=47, y=9}
	}
end

function _player_feet(e)
	return {x=e.pos.x + e.size.x/2, y=e.pos.y+e.size.y-1}
end

function ground_collision(e, prev_feet)
	e.grounded = false
	if e.size and e.v and e.v.y > 0 then
		local feet = _player_feet(e)
		-- check all mid squares
	 local dh = feet.y - prev_feet.y
	 dh = flr(dh/8)
	 log(dh)
		for i=0,dh do
			local x = feet.x
			local y = feet.y - i*8
			local at_feet = mget(feet.x/8, y/8)
			if fget(at_feet) & f.wall != 0 then
					e.v.y = 0
					local new_feet = {
						x=x, y=flr((y+1)/8)*8-1
					}
					e.pos.y = new_feet.y-player.size.y+1
					e.grounded = true
			end
		end
	end
end

function _update_ent(e)
	if e.size and e.v then
		prev_feet = _player_feet(e)
	end
	e.pos = vadd(e.pos, vmul(e.v, dt))
	if e.size and e.v then
		ground_collision(e, prev_feet)
	end
end

function update_camera()
	local cam={
		x=round_to(player.pos.x, 128),
		y=round_to(player.pos.y, 128)
	}
	camera(
		cam.x,
		cam.y
	)
end

function _handle_markers()
	for x=0,127 do
		for y=0,31 do
			local s = mget(x,y)
			if s == 61 do
				// pos debug
				log({x=x, y=y})
			end
		end
	end
end

function _update()
	_handle_markers()
	if btn(➡️) then player.v.x = hspeed
	elseif btn(⬅️) then player.v.x = -hspeed
	else player.v.x = 0 end
	if btn(🅾️) and player.grounded then
		player.v.y = -200
	end
	player.v.y += gravity * dt	
	_update_ent(player)
	_update_ent(particle)
	if dist(player.pos, treasure.pos) < 10 then
		selected = treasure
	else
		selected = nil
	end
	if not conveyer.anim_timer_c then
		conveyer.anim_timer_c = conveyer.anim_timer
	end
	conveyer.anim_timer_c -= dt
	if conveyer.anim_timer_c <= 0 then
		conveyer.anim_timer_c += conveyer.anim_timer
		conveyer.curr_sprite += 1
		if conveyer.curr_sprite > #conveyer.sprites then
			conveyer.curr_sprite = 1
		end
	end
	update_camera()
end

function draw_ent(e)
	if e.sprite then
		spr(e.sprite, e.pos.x, e.pos.y)
	elseif e.sprites then
		spr(e.sprites[e.curr_sprite], e.pos.x, e.pos.y)
	elseif e.text then
		print(e.text, e.pos.x, e.pos.y)
	end
end

function draw_hud()
	rectfill(0, 0, 127, 8, 1)
	print("0", 1, 2, 7)
end

function _draw()
	cls()
	map()
	spr(1, player.pos.x, player.pos.y)
	spr(2, treasure.pos.x, treasure.pos.y)
--	rectfill(feet.x, feet.y, feet.x+7, feet.y+7)
	
	if selected == treasure then
		spr(46, treasure.pos.x - 4, treasure.pos.y - 4, 2, 2)
	end
	draw_ent(particle)
	draw_ent(conveyer)

	camera()	
 draw_hud()
	draw_log()
	--map()
end
-->8
// vectors
function dist(p1, p2)
	return sqrt(
		(p1.x-p2.x)*(p1.x-p2.x)+
		(p1.y-p2.y)*(p1.y-p2.y)
	)
end

function vadd(p1, p2)
	return {x=p1.x+p2.x, y=p1.y+p2.y}
end

function vmul(p, s)
	return {x=p.x*s, y=p.y*s}
end


// math
function round_to(x, n)
	return flr(x / n) * n
end
-->8
function on_treasure(e)
	inv.gold += 1
	spawn_particle(e)
end
-->8
// -- log --
log_buff = {}
log_offset = {x=0, y=0}

function log(text, c)
	if not c then
		c = 7
	end
	add(log_buff, {qq(text), c})
	print(qq(text), c) // see it if game crashes
end

function draw_log()
	cursor(log_offset.x, log_offset.y)
  
	for item in all(log_buff) do
		print(item[1], item[2])
	end
	log_buff = {}
end


-- pq-debugging v11, by  @pancelor
-- https://www.lexaloffle.com/bbs/?tid=42367
printh'---'

-- quote all args and print to host console
-- usage:
--   pq("handles nils", many_vars, {tables=1, work=22, too=333})
function pq(...)
	printh(qq(...))
	return ...
end

-- quote all arguments into a string,
-- usage:
--   x=2 y=3 ?qq("x",x,"y",y)
function qq(...)
	local res=""
	for ix=1,select("#",...) do
		res..=_quote(select(ix,...),4).." "
	end
	return res
end

-- quote a single thing
-- like tostr(), but works for tables too
-- (don't call this directly; call pq or qq instead)
function _quote(tab,maxdepth)
	--avoid inf loop
	if type(tab)~="table" or maxdepth<=0 then
		return tostr(tab)
	end

	local res="{"
	for k,v in next,tab do
		res..=tostr(k).."=".._quote(v,maxdepth-1)..","
	end
	return res.."}"
end
